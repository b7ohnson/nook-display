rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Same list as firestore.rules; keep the two in step.
    function isFamily() {
      return request.auth != null
          && request.auth.uid in ['ZBe6UnAYNTSP2khYZKCI4FaGi8v2'];
    }

    // Photos are shown through tokenised download URLs, which do not pass
    // through these rules, so the display does not need public read.
    match /gallery/{allPaths=**} {
      allow read: if isFamily();
      // request.resource is null on delete, hence the separate rule.
      allow create, update: if isFamily()
                    && request.resource.size < 15 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if isFamily();
    }
  }
}
