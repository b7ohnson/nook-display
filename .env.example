# Copy this file to .env.local and fill in your values.
#
# To get a Client ID:
# 1. Go to https://console.cloud.google.com/
# 2. Create a project (or select an existing one)
# 3. APIs & Services → Enable APIs → enable "Google Calendar API"
# 4. APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client ID
#    - Application type: Web application
#    - Authorized JavaScript origins: http://localhost:5173
# 5. Copy the Client ID below

VITE_GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# Home location for the weather widget. Strongly recommended for the wall
# display: it does not move, so a fixed location avoids the geolocation
# permission prompt entirely and cannot silently fail to a mock reading.
# Leave both blank to fall back to browser geolocation.
# Find your coordinates at https://www.latlong.net/
VITE_HOME_LAT=
VITE_HOME_LON=

# News feeds for the Media tab, as a JSON array of {label, url}. Any RSS feed
# works. Leave blank for the NPR defaults (Top Stories + Technology).
# Example:
#   VITE_NEWS_FEEDS=[{"label":"World","url":"https://feeds.bbci.co.uk/news/world/rss.xml"}]
VITE_NEWS_FEEDS=

# Firebase — console.firebase.google.com → your project → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
