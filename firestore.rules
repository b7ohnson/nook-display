rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signing in with Google proves who someone is, not that they belong
    // here: any Google account can authenticate against this project. Family
    // data is therefore gated on a fixed list of account ids rather than on
    // "is signed in". Ids, not emails, because this repo is public. To add
    // someone: have them sign in once, copy their User UID from Firebase
    // console > Authentication, add it here and in storage.rules, and deploy.
    function isFamily() {
      return request.auth != null
          && request.auth.uid in [
            'ZBe6UnAYNTSP2khYZKCI4FaGi8v2',
            '4Hcpociv2NTiCtGUEK6K1DpwVQz1',
          ];
    }

    // Game rooms are joinable by unauthenticated players via QR code, so
    // reads and some writes are public. The display app is always signed in
    // (App.jsx gates on Firebase Auth), so it gets the wider permissions and
    // anonymous players get a narrow slot: they may only touch `players`, and
    // only while the room is inside its 2h lifetime.
    match /gameRooms/{roomCode} {

      // The exact document createRoom() writes: fixed field set, server
      // timestamp, no players yet.
      function wellFormedNewRoom() {
        return request.resource.data.keys().hasOnly(
                 ['code', 'game', 'state', 'players', 'payload', 'createdAt'])
            && request.resource.data.keys().hasAll(
                 ['code', 'game', 'state', 'players', 'payload', 'createdAt'])
            && request.resource.data.code == roomCode
            && request.resource.data.game is string
            && request.resource.data.state is string
            && request.resource.data.players is list
            && request.resource.data.players.size() == 0
            && request.resource.data.createdAt == request.time;
      }

      // Rooms are dead 2h after creation. useGameRoom already hides them in
      // the UI at that point; this stops writes reaching a stale room at all.
      function roomIsLive() {
        return resource.data.createdAt is timestamp
            && request.time < resource.data.createdAt + duration.value(2, 'h');
      }

      function playersFieldIsSane() {
        return request.resource.data.players is list
            && request.resource.data.players.size() <= 16;
      }

      // Anonymous players (addPlayer / updatePlayer) rewrite `players` and
      // nothing else — no touching createdAt, game, state, or payload.
      function onlyPlayersChanged() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['players']);
      }

      // Guests on Jeopardy and Family Feud also buzz in and send answers.
      // Those writes touch only these payload keys; everything else in the
      // payload (board, scores, turn state) stays display-only. A guest may
      // close the buzzers (that is what buzzing in does) but never open them.
      function onlyGuestPayloadChanged() {
        let before = resource.data.payload;
        let after  = request.resource.data.payload;
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['payload'])
            && before is map && after is map
            && after.diff(before).affectedKeys().hasOnly(
                 ['buzzedBy', 'buzzersOpen', 'submittedAnswer', 'fmSubmit', 'fmDuplicate'])
            && (after.get('buzzersOpen', false) != true
                || before.get('buzzersOpen', false) == true);
      }

      // Players join by code, so a single room is public. Listing every open
      // room is not something a guest needs.
      allow get: if true;
      allow list: if isFamily();

      // Only the signed-in display opens a room.
      allow create: if isFamily() && wellFormedNewRoom();

      allow update: if
        // createRoom() uses setDoc() with no merge, so reopening a room at a
        // code that still has a stale document counts as an update, not a
        // create. Let the display reclaim it with a fresh, well-formed room.
        (isFamily() && wellFormedNewRoom())
        // Normal in-game writes, while the room is still alive.
        || (roomIsLive()
            && playersFieldIsSane()
            && (isFamily() || onlyPlayersChanged() || onlyGuestPayloadChanged()));

      allow delete: if isFamily();
    }

    // Everything else is family data and requires a family account. These are
    // listed per collection rather than as a `/{document=**}` catch-all: that
    // recursive wildcard also matches /gameRooms/{roomCode}, and because
    // Firestore grants access if *any* matching rule allows, it silently
    // bypassed every restriction above for signed-in users.
    // Adding a new collection means adding it here — default is deny.
    match /skylight/{document=**} {
      allow read, write: if isFamily();
    }
    match /scores/{document=**} {
      allow read, write: if isFamily();
    }
    match /gameContent/{document=**} {
      allow read, write: if isFamily();
    }
  }
}
